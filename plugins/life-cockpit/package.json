{
  "name": "life-cockpit",
  "version": "0.19.0",
  "description": "人生驾驶舱：番茄时间轴、禅定模式、五行节律表、当日番茄流水、积分账本、六层目标树、夜班候选区拍板面、睡前复盘，以及把这一切推到窗口之外去的推动器。",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "pretest": "node scripts/build-core-for-test.mjs",
    "test": "node --test test/",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "pomodoro"
  ],
  "author": "hanshou101",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.4",
    "obsidian": "^1.13.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.60.1"
  },
  "dependencies": {
    "convex": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  }
}
